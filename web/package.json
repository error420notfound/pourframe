{
  "name": "pourframe-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/precompress.mjs",
    "build:pages": "tsc -b && vite build --config vite.pages.config.ts && node scripts/stamp-pages-service-worker.mjs",
    "lint": "tsc -b --pretty false",
    "test": "vitest run && node --test scripts/font-asset.node-test.mjs scripts/precompress.node-test.mjs scripts/remote-asset-config.node-test.mjs scripts/service-worker.node-test.mjs",
    "test:e2e": "playwright test --browser=all",
    "preview": "vite preview"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "driver.js": "^1.8.0",
    "echarts": "^6.1.0",
    "geist": "^1.7.2",
    "gsap": "^3.15.0",
    "lucide-react": "^1.31.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "jsdom": "^30.0.1",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
